# Laravel backend root URL (where artisan / public index lives).
# Do NOT include /api — the app adds /api/auth/login, /api/sales, etc.
#
# Optional: leave empty and set the URL once on the in-app "Backend setup" screen
# (saved in the browser). If set here, that screen is skipped and login opens directly.
#
# NOTE: .env.local overrides .env in Vite dev mode. If login hits localhost:8000,
# check .env.local is not set to http://localhost:8000.
#
# Production API (deployed Laravel — no trailing slash):
VITE_API_BASE_URL=https://finance.skytechsl.com/pos/backend/public

# Local development (comment production line above and use this):
# VITE_API_BASE_URL=http://localhost:8000

# Subfolder deploy (public_html/pos → https://domain.com/pos/)
VITE_BASE_PATH=/pos/
VITE_APP_BASE_PATH=/pos

VITE_APP_NAME=POS System
